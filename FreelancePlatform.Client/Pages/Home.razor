@page "/"
@inject HttpClient Http

<div class="container mt-4 mb-5">
    @if (order == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Завантаження...</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h2 class="card-title fw-bold">@order.Title</h2>
                <span class="badge bg-success">💰 @order.Budget грн</span>
                <hr />
                <h5>Опис:</h5>
                <p>@order.Description</p>
                <p>Статус: <strong>@order.Status</strong></p>
            </div>
        </div>

        @if (UserState.IsLoggedIn && UserState.Role == "Freelancer" && order.Status == "Open")
        {
            <div class="card shadow-sm border-primary mb-4">
                <div class="card-header bg-primary text-white">📝 Залишити пропозицію</div>
                <div class="card-body p-4">
                    <textarea class="form-control mb-3" rows="4" @bind="proposalText" placeholder="Напишіть ваш відгук..."></textarea>
                    <button class="btn btn-primary" @onclick="SubmitProposal" disabled="@isSubmitting">
                        @(isSubmitting ? "Відправка..." : "Відправити")
                    </button>
                    @if (showSuccess) { <span class="text-success ms-3">✅ Успішно!</span> }
                </div>
            </div>
        }
        
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private OrderModel? order;
    private string proposalText = "";
    private bool isSubmitting = false;
    private bool showSuccess = false;

    // ОДИН единственный метод инициализации
    protected override async Task OnInitializedAsync()
    {
        await LoadOrderDetails();
    }

    private async Task LoadOrderDetails()
    {
        try {
            order = await Http.GetFromJsonAsync<OrderModel>($"https://cursach-production.up.railway.app/api/orders/{Id}");
        } catch (Exception ex) { Console.WriteLine(ex.Message); }
    }

    private async Task SubmitProposal()
    {
        if (string.IsNullOrWhiteSpace(proposalText)) return;
        isSubmitting = true;
        var newProposal = new {
            OrderId = this.Id,
            FreelancerName = $"{UserState.Name} {UserState.LastName}",
            Text = proposalText,
            Price = order?.Budget
        };
        var response = await Http.PostAsJsonAsync("https://cursach-production.up.railway.app/api/proposals", newProposal);
        if (response.IsSuccessStatusCode) {
            showSuccess = true;
            proposalText = "";
        }
        isSubmitting = false;
    }

    public class OrderModel {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Budget { get; set; }
        public string Status { get; set; } = "Open";
    }
}