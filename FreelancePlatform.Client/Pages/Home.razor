@page "/"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using FreelancePlatform.Client

<PageTitle>Активні проєкти — Біржа</PageTitle>

<main class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            @if (UserState.IsLoggedIn && UserState.Role == "Customer")
            {
                <span>Мої замовлення</span>
            }
            else
            {
                <span>Активні проєкти</span>
            }
        </h2>
        <button class="btn btn-outline-primary" @onclick="LoadOrders">🔄 Оновити</button>
    </div>

    @if (orders == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Завантаження замовлень...</p>
        </div>
    }
    else if (!orders.Any())
    {
        <div class="alert alert-info text-center py-4">
            @if (UserState.IsLoggedIn && UserState.Role == "Customer")
            {
                <p class="mb-0">У вас ще немає замовлень. <a href="create-order">Створіть перше!</a></p>
            }
            else
            {
                <p class="mb-0">Немає доступних замовлень. Зайдіть пізніше!</p>
            }
        </div>
    }
    else
    {
        <div id="ordersList">
            @foreach (var order in orders)
            {
                <NavLink href="@($"order/{order.Id}")" class="card text-decoration-none mb-3" style="display: block; cursor: pointer; color: inherit;">
                    <article class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h3 class="mb-0">@order.Title</h3>
                            <span class="badge @(order.Status == "Open" ? "bg-success" : "bg-warning") ms-2 flex-shrink-0">
                                @(order.Status == "Open" ? "Відкрите" : "В роботі")
                            </span>
                        </div>
                        
                        @* Скорочений опис — максимум 120 символів *@
                        <p class="text-muted mb-2">
                            @(order.Description.Length > 120 
                                ? order.Description.Substring(0, 120) + "..." 
                                : order.Description)
                        </p>
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <span class="budget fw-semibold">💰 Бюджет: @order.Budget грн</span>
                                @if (order.CustomerName != null)
                                {
                                    <small class="text-muted">👤 @order.CustomerName</small>
                                }
                            </div>
                            
                            @if (order.Status == "Open" && UserState.Role == "Freelancer")
                            {
                                <div>
                                    <button class="btn btn-success btn-sm rounded-pill px-3" @onclick="() => TakeJob(order.Id)" @onclick:stopPropagation>Взяти в роботу</button>
                                </div>
                            }
                        </div>
                    </article>
                </NavLink>
            }
        </div>
    }
</main>

@code {
    private List<OrderModel> orders = new();

    private void TakeJob(int orderId)
    {
        NavigationManager.NavigateTo($"order-details/{orderId}");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        try 
        {
            // Передаємо роль і ID щоб API повернув потрібні замовлення
            string url = "api/orders";
            if (UserState.IsLoggedIn)
            {
                url = $"api/orders?role={UserState.Role}&userId={UserState.Id}";
            }
            orders = await Http.GetFromJsonAsync<List<OrderModel>>(url) ?? new();
        } 
        catch (Exception ex) 
        { 
            Console.WriteLine($"Помилка завантаження: {ex.Message}"); 
        }
    }

    private async Task ChangeStatus(int orderId, string newStatus)
    {
        // Відправляємо PUT запит
        var response = await Http.PutAsJsonAsync($"api/orders/{orderId}/status", newStatus);
        if (response.IsSuccessStatusCode) 
        {
            await LoadOrders(); // Оновлюємо список після зміни
        }
    }

    public class OrderModel
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Budget { get; set; }
        public string Status { get; set; } = "Open";
        
        // Ім'я замовника (береться з Customer)
        public string? CustomerName => Customer != null ? $"{Customer.Name} {Customer.LastName}" : null;
        
        public CustomerInfo? Customer { get; set; }
    }

    public class CustomerInfo
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string LastName { get; set; } = "";
    }
}