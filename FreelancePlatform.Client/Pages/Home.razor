@page "/"
@inject HttpClient Http

<PageTitle>Всі замовлення — Біржа</PageTitle>

<main class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Активні проєкти</h2>
        <button class="btn btn-outline-primary" @onclick="LoadOrders">🔄 Оновити</button>
    </div>

    @if (orders == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Завантаження замовлень...</p>
        </div>
    }
    else
    {
        <div id="ordersList">
            @foreach (var order in orders)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <h3>@order.Title</h3>
                        <p>@order.Description</p>
                        <p class="budget">💰 Бюджет: @order.Budget грн</p>
                        <span class="badge @(order.Status == "Open" ? "bg-success" : "bg-warning")">@order.Status</span>
                        
                        <div class="mt-3">
                            <a href="/order/@order.Id" class="btn btn-outline-secondary btn-sm">Деталі</a>

                            @if (order.Status == "Open" && UserState.Role == "Freelancer")
                            {
                                <button class="btn btn-sm btn-primary ms-2" @onclick="() => ChangeStatus(order.Id, \"InProgress\")">Взяти в роботу</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</main>

@code {
    private List<OrderModel> orders = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        try 
        {
            orders = await Http.GetFromJsonAsync<List<OrderModel>>("https://cursach-production.up.railway.app/api/orders") ?? new();
        } 
        catch (Exception ex) 
        { 
            Console.WriteLine($"Помилка завантаження: {ex.Message}"); 
        }
    }

    private async Task ChangeStatus(int orderId, string newStatus)
    {
        // Відправляємо PUT запит
        var response = await Http.PutAsJsonAsync($"https://cursach-production.up.railway.app/api/orders/{orderId}/status", newStatus);
        if (response.IsSuccessStatusCode) 
        {
            await LoadOrders(); // Оновлюємо список після зміни
        }
    }

    public class OrderModel
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Budget { get; set; }
        public string Status { get; set; } = "Open";
    }
}