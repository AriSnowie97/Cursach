@using FreelancePlatform.Client
@page "/order-details/{Id:int}"
@page "/order/{Id:int}"
@inject HttpClient Http
@inject NavigationManager NavigationManager


<div class="container mt-4">
    @if (order == null)
    {
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Завантаження даних замовлення...</span>
        </div>
    }
    else
    {
        <!-- Картка замовлення -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">@order.Title</h3>
            </div>
            <div class="card-body">
                <p class="lead">@order.Description</p>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Бюджет:</strong> @order.Budget грн</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Статус замовлення:</strong> <span class="badge bg-info">@order.Status</span></p>
                    </div>
                </div>

                @if (UserState.IsLoggedIn && UserState.Role == "Customer" && order.CustomerId == UserState.Id && order.Status == "InProgress")
                {
                    <div class="mt-3 border-top pt-3">
                        <button class="btn btn-success" @onclick="CompleteOrder">
                            ✅ Позначити як виконане (Завершити замовлення)
                        </button>
                    </div>
                }
            </div>
        </div>
 
        <!-- Відображення помилок або успіху -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        @if (isSuccess)
        {
            <div class="alert alert-success">Ваш відгук успішно надіслано!</div>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }

        <!-- Форма пропозиції для Фрілансерів -->
        @if (UserState.IsLoggedIn && UserState.Role == "Freelancer") 
        {
            <div class="card p-4 mb-4 shadow-sm">
                <h4>Запропонувати свої послуги для виконання</h4>
                <EditForm Model="@newProposal" OnValidSubmit="SendProposal">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="mb-3">
                        <label class="form-label">Пропонована ціна (грн):</label>
                        <InputNumber @bind-Value="newProposal.Price" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Супровідний лист / Ваше рішення:</label>
                        <InputTextArea @bind-Value="newProposal.CoverLetter" class="form-control" rows="3" placeholder="Опишіть ваш досвід або як ви плануєте виконати завдання..." />
                    </div>

                    <button type="submit" class="btn btn-success">Надіслати пропозицію</button>
                </EditForm>
            </div>
        }
        else if (!UserState.IsLoggedIn)
        {
            <div class="alert alert-warning">
                Щоб взяти замовлення в роботу, будь ласка, <a href="login">авторизуйтесь</a>.
            </div>
        }

        <!-- Список вже наявних пропозицій до цього замовлення -->
        <h4 class="mt-4">Відгуки інших фрілансерів:</h4>
        @if (order.Proposals == null || !order.Proposals.Any())
        {
            <p class="text-muted">До цього замовлення ще немає пропозицій. Будьте першими!</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var proposal in order.Proposals)
                {
                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center mb-2 shadow-sm" style="border-radius: 8px;">
                        <div>
                            <p class="mb-1 fw-semibold">@proposal.CoverLetter</p>
                            <small class="text-muted">
                                Відправник: @(proposal.Freelancer != null ? $"{proposal.Freelancer.Name} {proposal.Freelancer.LastName}" : $"Фрілансер ID: {proposal.FreelancerId}")
                            </small>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-primary fs-6">@proposal.Price грн</span>
                            
                            @if (UserState.IsLoggedIn && UserState.Role == "Customer" && order.CustomerId == UserState.Id && order.Status == "Open")
                            {
                                <button class="btn btn-sm btn-success rounded-pill px-3" @onclick="() => AcceptProposal(proposal)">
                                    Оберу цього фрілансера
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Order order;
    private Proposal newProposal = new Proposal();
    private string errorMessage;
    private string successMessage;
    private bool isSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrderDetails();
    }

    private async Task LoadOrderDetails()
    {
        try
        {
            errorMessage = null;
            successMessage = null;
            // Запитуємо дані замовлення в API
            order = await Http.GetFromJsonAsync<Order>($"api/orders/{Id}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Не вдалося завантажити дані замовлення: {ex.Message}";
        }
    }

    private async Task SendProposal()
    {
        isSuccess = false;
        errorMessage = null;
        successMessage = null;

        // Пов'язуємо модель пропозиції з поточним замовленням та користувачем
        newProposal.OrderId = Id;
        newProposal.FreelancerId = UserState.UserId; // ID поточного авторизованого користувача

        try
        {
            var response = await Http.PostAsJsonAsync("api/proposals", newProposal);

            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
                newProposal = new Proposal(); // Скидаємо форму
                await LoadOrderDetails();      // Оновлюємо список пропозицій на сторінці
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                errorMessage = $"Помилка при збереженні на сервері: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Сталася непередбачена помилка: {ex.Message}";
        }
    }

    private async Task AcceptProposal(Proposal proposal)
    {
        isSuccess = false;
        errorMessage = null;
        successMessage = null;

        try
        {
            // Оновлюємо статус замовлення на "InProgress"
            var response = await Http.PutAsJsonAsync($"api/orders/{Id}/status", "InProgress");

            if (response.IsSuccessStatusCode)
            {
                await LoadOrderDetails();      // Оновлюємо деталі замовлення
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                errorMessage = $"Не вдалося оновити статус замовлення: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Сталася непередбачена помилка: {ex.Message}";
        }
    }
 
    private async Task CompleteOrder()
    {
        errorMessage = null;
        successMessage = null;
 
        try
        {
            // Оновлюємо статус замовлення на "Completed"
            var response = await Http.PutAsJsonAsync($"api/orders/{Id}/status", "Completed");
 
            if (response.IsSuccessStatusCode)
            {
                successMessage = "Замовлення успішно виконано та завершено!";
                await LoadOrderDetails();      // Оновлюємо деталі замовлення
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                errorMessage = $"Не вдалося оновити статус замовлення: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Сталася непередбачена помилка: {ex.Message}";
        }
    }
 
    public class Order
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Budget { get; set; }
        public string Status { get; set; } = "";
        public int CustomerId { get; set; }
        public List<Proposal> Proposals { get; set; } = new();
    }

    public class Proposal
    {
        public int Id { get; set; }
        public string CoverLetter { get; set; } = "";
        public decimal Price { get; set; }
        public int OrderId { get; set; }
        public int FreelancerId { get; set; }
        public FreelancerModel? Freelancer { get; set; }
    }

    public class FreelancerModel
    {
        public string Name { get; set; } = "";
        public string LastName { get; set; } = "";
    }
}