@using FreelancePlatform.Client
@page "/order-details/{Id:int}"
@page "/order/{Id:int}"
@inject HttpClient Http
@inject NavigationManager NavigationManager


<div class="container mt-4">
    @if (order == null)
    {
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка данных заказа...</span>
        </div>
    }
    else
    {
        <!-- Карточка заказа -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">@order.Title</h3>
            </div>
            <div class="card-body">
                <p class="lead">@order.Description</p>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Бюджет:</strong> @order.Budget руб.</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Статус заказа:</strong> <span class="badge bg-info">@order.Status</span></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Отображение ошибок или успеха -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        @if (isSuccess)
        {
            <div class="alert alert-success">Ваш отклик успешно отправлен!</div>
        }

        <!-- Форма предложения для Фрилансеров -->
        @if (UserState.IsLoggedIn && UserState.Role == "Freelancer") 
        {
            <div class="card p-4 mb-4 shadow-sm">
                <h4>Предложить свои услуги к выполнению</h4>
                <EditForm Model="@newProposal" OnValidSubmit="SendProposal">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="mb-3">
                        <label class="form-label">Предлагаемая цена (руб.):</label>
                        <InputNumber @bind-Value="newProposal.Price" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Сопроводительное письмо / Ваше решение:</label>
                        <InputTextArea @bind-Value="newProposal.CoverLetter" class="form-control" rows="3" placeholder="Опишите ваш опыт или как вы планируете выполнить задачу..." />
                    </div>

                    <button type="submit" class="btn btn-success">Отправить предложение</button>
                </EditForm>
            </div>
        }
        else if (!UserState.IsLoggedIn)
        {
            <div class="alert alert-warning">
                Чтобы взять заказ в работу, пожалуйста, <a href="/login">авторизуйтесь</a>.
            </div>
        }

        <!-- Список уже имеющихся предложений к этому заказу -->
        <h4 class="mt-4">Отклики других фрилансеров:</h4>
        @if (order.Proposals == null || !order.Proposals.Any())
        {
            <p class="text-muted">К этому заказу еще нет предложений. Будьте первыми!</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var proposal in order.Proposals)
                {
                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center mb-2 shadow-sm" style="border-radius: 8px;">
                        <div>
                            <p class="mb-1 fw-semibold">@proposal.CoverLetter</p>
                            <small class="text-muted">
                                Отправитель: @(proposal.Freelancer != null ? $"{proposal.Freelancer.Name} {proposal.Freelancer.LastName}" : $"Фрилансер ID: {proposal.FreelancerId}")
                            </small>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-primary fs-6">@proposal.Price руб.</span>
                            
                            @if (UserState.IsLoggedIn && UserState.Role == "Customer" && order.CustomerId == UserState.Id && order.Status == "Open")
                            {
                                <button class="btn btn-sm btn-success rounded-pill px-3" @onclick="() => AcceptProposal(proposal)">
                                    Возьму этого фрилансера
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Order order;
    private Proposal newProposal = new Proposal();
    private string errorMessage;
    private bool isSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrderDetails();
    }

    private async Task LoadOrderDetails()
    {
        try
        {
            errorMessage = null;
            // Запрашиваем данные заказа у API
            order = await Http.GetFromJsonAsync<Order>($"api/orders/{Id}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось загрузить данные заказа: {ex.Message}";
        }
    }

    private async Task SendProposal()
    {
        isSuccess = false;
        errorMessage = null;

        // Связываем модель предложения с текущим заказом и пользователем
        newProposal.OrderId = Id;
        newProposal.FreelancerId = UserState.UserId; // ID текущего авторизованного пользователя

        try
        {
            var response = await Http.PostAsJsonAsync("api/proposals", newProposal);

            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
                newProposal = new Proposal(); // Сбрасываем форму
                await LoadOrderDetails();      // Обновляем список предложений на странице
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                errorMessage = $"Ошибка при сохранении на сервере: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Произошла непредвиденная ошибка: {ex.Message}";
        }
    }

    private async Task AcceptProposal(Proposal proposal)
    {
        isSuccess = false;
        errorMessage = null;

        try
        {
            // Обновляем статус заказа на "InProgress"
            var response = await Http.PutAsJsonAsync($"api/orders/{Id}/status", "InProgress");

            if (response.IsSuccessStatusCode)
            {
                await LoadOrderDetails();      // Обновляем детали заказа
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                errorMessage = $"Не удалось обновить статус заказа: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Произошла непредвиденная ошибка: {ex.Message}";
        }
    }

    public class Order
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Budget { get; set; }
        public string Status { get; set; } = "";
        public int CustomerId { get; set; }
        public List<Proposal> Proposals { get; set; } = new();
    }

    public class Proposal
    {
        public int Id { get; set; }
        public string CoverLetter { get; set; } = "";
        public decimal Price { get; set; }
        public int OrderId { get; set; }
        public int FreelancerId { get; set; }
        public FreelancerModel? Freelancer { get; set; }
    }

    public class FreelancerModel
    {
        public string Name { get; set; } = "";
        public string LastName { get; set; } = "";
    }
}