@page "/login"
@using FreelancePlatform.Client
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container mt-5">
    <div class="card shadow p-4 mx-auto" style="max-width: 400px; border-radius: 12px;">
        <h3 class="text-center mb-4 fw-bold">Вхід</h3>
        <div class="mb-3">
            <label class="form-label fw-bold">Email:</label>
            <input type="email" class="form-control" @bind="loginModel.Email" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Пароль:</label>
            <input type="password" class="form-control" @bind="loginModel.Password" />
        </div>
        <button class="btn btn-primary w-100 rounded-pill fw-bold py-2 mt-2" @onclick="HandleLogin">Увійти</button>
    </div>
</div>

@code {
    private LoginRequest loginModel = new LoginRequest();

    private async Task HandleLogin()
    {
        try
        {
            // Відправляємо дані на бекенд
            var response = await Http.PostAsJsonAsync("api/auth/login", loginModel);

            if (response.IsSuccessStatusCode)
            {
                // Налаштування для десеріалізації: дозволяємо зчитувати 'id' незалежно від регістру букв
                var jsonOptions = new System.Text.Json.JsonSerializerOptions 
                { 
                    PropertyNameCaseInsensitive = true 
                };

                // Передаємо jsonOptions другим параметром!
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>(jsonOptions);

                if (result != null)
                {
                    // Тепер тут залізобетонно запишеться реальний ID користувача з бази даних
                    await UserState.SaveSession(JS, result.Id, result.Name, result.LastName, result.Role);
                    
                    // Переходимо на головну
                    Navigation.NavigateTo("/");
                }
            }
        }
        catch (Exception)
        {
            Console.WriteLine("Помилка авторизації або з'єднання з сервером.");
        }
    }

    public class LoginRequest 
    { 
        public string Email { get; set; } = ""; 
        public string Password { get; set; } = ""; 
    }

    public class LoginResponse
    {
        public int Id { get; set; } 
        public string Name { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Role { get; set; } = "";
    }
}