@page "/profile"
@using FreelancePlatform.Client
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>Мій профіль — Біржа</PageTitle>

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm p-4" style="border-radius: 16px;">
        <h2 class="mb-3">Мій профіль</h2>
        <hr />

        @* Аватарка *@
        <div class="d-flex align-items-center gap-4 mb-4">
            <div class="avatar-circle-lg" style="width: 90px; height: 90px; border-radius: 50%; overflow: hidden; border: 3px solid #4f46e5; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #4f46e5, #7c3aed); font-size: 2rem; font-weight: bold; color: white;">
                @if (!string.IsNullOrEmpty(UserState.AvatarUrl))
                {
                    <img src="@UserState.AvatarUrl" alt="Аватарка" style="width: 100%; height: 100%; object-fit: cover;" />
                }
                else
                {
                    <span>@(UserState.Name.Length > 0 ? UserState.Name.Substring(0, 1).ToUpper() : "?")</span>
                }
            </div>
            <div>
                <h4 class="mb-1 fw-bold">@UserState.Name @UserState.LastName</h4>
                <span class="badge @(UserState.Role == "Customer" ? "bg-primary" : "bg-success") px-3 py-2">
                    @(UserState.Role == "Customer" ? "👔 Замовник" : "💼 Фрілансер")
                </span>
            </div>
        </div>

        @* Завантаження аватарки *@
        <div class="mb-4 p-3 rounded" style="background: #f8fafc; border: 1px dashed #cbd5e1;">
            <h6 class="fw-semibold mb-2">📷 Змінити аватарку</h6>
            <p class="text-muted small mb-2">Оберіть фото (JPG, PNG, WebP). Максимум ~375KB.</p>
            <input type="file" 
                   id="avatar-input"
                   class="form-control form-control-sm mb-2" 
                   accept="image/jpeg,image/png,image/webp"
                   @onchange="HandleAvatarFileChange" />
            
            @if (!string.IsNullOrEmpty(avatarUploadMessage))
            {
                <div class="alert @(avatarUploadSuccess ? "alert-success" : "alert-danger") py-2 mb-0 small">
                    @avatarUploadMessage
                </div>
            }
            
            @if (isUploadingAvatar)
            {
                <div class="d-flex align-items-center gap-2 text-muted small mt-2">
                    <div class="spinner-border spinner-border-sm"></div>
                    <span>Завантаження...</span>
                </div>
            }
        </div>

        <div class="mt-3 border-top pt-3">
            <button class="btn btn-outline-danger rounded-pill px-4" @onclick="HandleLogout">
                🚪 Вийти з акаунту
            </button>
        </div>
    </div>
</div>

@code {
    private string? avatarUploadMessage;
    private bool avatarUploadSuccess = false;
    private bool isUploadingAvatar = false;

    private async Task HandleAvatarFileChange(ChangeEventArgs e)
    {
        avatarUploadMessage = null;
        isUploadingAvatar = true;
        StateHasChanged();

        try
        {
            // Читаємо файл через JS Interop (конвертуємо в base64)
            var base64 = await JS.InvokeAsync<string>("readFileAsBase64", "avatar-input");
            
            if (string.IsNullOrEmpty(base64))
            {
                avatarUploadMessage = "Не вдалося прочитати файл.";
                avatarUploadSuccess = false;
                return;
            }

            // Відправляємо на сервер
            var response = await Http.PostAsJsonAsync($"api/avatar/{UserState.Id}", new { AvatarBase64 = base64 });

            if (response.IsSuccessStatusCode)
            {
                await UserState.UpdateAvatar(JS, base64);
                avatarUploadMessage = "✅ Аватарку успішно оновлено!";
                avatarUploadSuccess = true;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                avatarUploadMessage = $"Помилка: {error}";
                avatarUploadSuccess = false;
            }
        }
        catch (Exception ex)
        {
            avatarUploadMessage = $"Помилка: {ex.Message}";
            avatarUploadSuccess = false;
        }
        finally
        {
            isUploadingAvatar = false;
        }
    }

    private async Task HandleLogout()
    {
        await UserState.ClearSession(JS);
        Navigation.NavigateTo("/");
    }
}