@page "/my-proposals"
@using FreelancePlatform.Client
@inject HttpClient Http
@inject NavigationManager Navigation // <-- 1. Добавили менеджер навигации

<PageTitle>Мої пропозиції — Біржа</PageTitle>

<div class="container mt-4">
    <h2 class="mb-4">Мої відгуки на замовлення</h2>

    @if (!UserState.IsLoggedIn || UserState.Role != "Freelancer")
    {
        <div class="alert alert-warning">
            Ця сторінка доступна лише для авторизованих фрілансерів. Будь ласка, увійдіть в систему.
        </div>
    }
    else if (proposals == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Завантаження...</p>
        </div>
    }
    else if (proposals.Length == 0)
    {
        <div class="alert alert-info">
            Ви ще не залишили жодної пропозиції до замовлень.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var prop in proposals)
            {
                <div class="col-12 mb-3">
                    <div class="card shadow-sm border-primary" style="border-radius: 10px;">
                        <div class="card-body">
                            <h5 class="card-title">Відгук на замовлення #@prop.OrderId</h5>
                            <p class="card-text text-muted">@prop.CoverLetter</p>
                            
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="text-success fw-bold">💰 Ваша ціна: $@prop.Price</span>
                                
                                @* 2. ДОБАВИЛИ КНОПКУ ПЕРЕХОДА *@
                                <button class="btn btn-primary rounded-pill px-4" @onclick="() => GoToOrder(prop.OrderId)">
                                    Переглянути замовлення
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private Proposal[]? proposals;

    protected override async Task OnInitializedAsync()
    {
        if (UserState.IsLoggedIn && UserState.Role == "Freelancer")
        {
            // Здесь будет твой реальный запрос к БД, когда запустишь бекенд:
            // proposals = await Http.GetFromJsonAsync<Proposal[]>($"api/proposals/user/{UserState.Name}");

            // А пока заглушка для красоты
            proposals = new[]
            {
                new Proposal { OrderId = 1, CoverLetter = "Вітаю! Я маю великий досвід у дизайні лендінгів у Figma...", Price = 150 },
                new Proposal { OrderId = 3, CoverLetter = "Привіт! Напишу курсову роботу на C#...", Price = 45 }
            };
        }
    }

    // 3. МЕТОД ДЛЯ ПЕРЕХОДА
    private void GoToOrder(int orderId)
    {
        // Перекидываем пользователя на страницу деталей
        Navigation.NavigateTo($"/order/{orderId}");
    }

    public class Proposal
    {
        public int OrderId { get; set; }
        public string CoverLetter { get; set; } = "";
        public decimal Price { get; set; }
    }
}