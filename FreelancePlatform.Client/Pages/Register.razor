@page "/register"
@using FreelancePlatform.Client
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container mt-5">
    <div class="card shadow p-4 mx-auto" style="max-width: 400px; border-radius: 12px;">
        <h3 class="text-center mb-4 fw-bold">Реєстрація</h3>
        
        <div class="mb-3">
            <label class="form-label fw-bold">Ім'я:</label>
            <input type="text" class="form-control" @bind="registerModel.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Прізвище:</label>
            <input type="text" class="form-control" @bind="registerModel.LastName" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Email:</label>
            <input type="email" class="form-control" @bind="registerModel.Email" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Пароль:</label>
            <input type="password" class="form-control" @bind="registerModel.Password" />
        </div>
        <div class="mb-4">
            <label class="form-label fw-bold">Хто ви?</label>
            <select class="form-select" @bind="registerModel.Role">
                <option value="Customer">Замовник (Шукаю виконавця)</option>
                <option value="Freelancer">Фрілансер (Шукаю роботу)</option>
            </select>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger shadow-sm py-2 px-3 small">⚠️ @errorMessage</div>
        }

        <button class="btn btn-primary w-100 rounded-pill fw-bold py-2" @onclick="HandleRegister" disabled="@isLoading">
            @(isLoading ? "Реєстрація..." : "Зареєструватися")
        </button>
    </div>
</div>

@code {
    private RegisterRequest registerModel = new RegisterRequest();
    private string errorMessage = "";
    private bool isLoading = false;

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = "";

        try
        {
            // Відправляємо дані на бекенд Railway
            var response = await Http.PostAsJsonAsync("https://cursach-production.up.railway.app/api/auth/register", registerModel);

            if (response.IsSuccessStatusCode)
            {
                // Налаштування для десеріалізації: дозволяємо читати 'id' незалежно від регістру літер
                var jsonOptions = new System.Text.Json.JsonSerializerOptions 
                { 
                    PropertyNameCaseInsensitive = true 
                };

                // Передаємо jsonOptions другим параметром!
                var result = await response.Content.ReadFromJsonAsync<RegisterResponse>(jsonOptions);

                if (result != null)
                {
                    // Тепер тут залізобетонно буде реальний ID з бази даних, а не 0
                    await UserState.SaveSession(JS, result.Id, result.Name, result.LastName, result.Role);
                    
                    // Перенаправляємо на головну
                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                errorMessage = string.IsNullOrEmpty(errorMsg) ? "Помилка реєстрації. Перевірте дані." : errorMsg;
            }
        }
        catch (Exception)
        {
            errorMessage = "Помилка з'єднання з сервером.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Моделі для форми
    public class RegisterRequest 
    { 
        public string Name { get; set; } = ""; 
        public string LastName { get; set; } = ""; 
        public string Email { get; set; } = ""; 
        public string Password { get; set; } = ""; 
        public string Role { get; set; } = "Customer"; 
    }

    // Модель відповіді
    public class RegisterResponse 
    { 
        public int Id { get; set; } 
        public string Name { get; set; } = ""; 
        public string LastName { get; set; } = ""; 
        public string Role { get; set; } = ""; 
    }
}