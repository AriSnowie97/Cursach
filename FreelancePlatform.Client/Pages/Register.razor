@page "/register"
@using FreelancePlatform.Client
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container mt-5">
    <div class="card shadow p-4 mx-auto" style="max-width: 400px;">
        <h3 class="text-center mb-4">Реєстрація</h3>
        
        <div class="mb-3">
            <label class="form-label">Ім'я:</label>
            <input type="text" class="form-control" @bind="registerModel.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">Прізвище:</label>
            <input type="text" class="form-control" @bind="registerModel.LastName" />
        </div>
        <div class="mb-3">
            <label class="form-label">Email:</label>
            <input type="email" class="form-control" @bind="registerModel.Email" />
        </div>
        <div class="mb-3">
            <label class="form-label">Пароль:</label>
            <input type="password" class="form-control" @bind="registerModel.Password" />
        </div>
        <div class="mb-4">
            <label class="form-label">Хто ви?</label>
            <select class="form-select" @bind="registerModel.Role">
                <option value="Customer">Замовник (Шукаю виконавця)</option>
                <option value="Freelancer">Фрілансер (Шукаю роботу)</option>
            </select>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <button class="btn btn-primary w-100 rounded-pill" @onclick="HandleRegister" disabled="@isLoading">
            @(isLoading ? "Реєстрація..." : "Зареєструватися")
        </button>
    </div>
</div>

@code {
    private RegisterRequest registerModel = new RegisterRequest();
    private string errorMessage = "";
    private bool isLoading = false;

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = "";

        try
        {
            // 1. Відправляємо дані на ПРАВИЛЬНУ адресу (туди, де бекенд зберігає їх у БД)
            var response = await Http.PostAsJsonAsync("https://cursach-production.up.railway.app/api/auth/register", registerModel);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RegisterResponse>();

                if (result != null)
                {
                    // 2. Одразу зберігаємо користувача в LocalStorage (автоматичний логін)
                    await UserState.SaveSession(JS, result.Id, result.Name, result.LastName, result.Role);
                    
                    // 3. Перекидаємо на головну сторінку
                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                // Якщо бекенд відповів помилкою (наприклад, такий email вже є)
                var errorMsg = await response.Content.ReadAsStringAsync();
                errorMessage = string.IsNullOrEmpty(errorMsg) ? "Помилка реєстрації. Перевірте дані." : errorMsg;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Помилка з'єднання з сервером.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Моделі для форми
    public class RegisterRequest 
    { 
        public string Name { get; set; } = ""; 
        public string LastName { get; set; } = ""; 
        public string Email { get; set; } = ""; 
        public string Password { get; set; } = ""; 
        public string Role { get; set; } = "Customer"; // Значення за замовчуванням
    }

    // Модель, яку ми очікуємо отримати від бекенду після успішного збереження в БД
    public class RegisterResponse 
    { 
        public int Id { get; set; } // <-- ДОБАВИТЬ ЭТО
        public string Name { get; set; } = ""; 
        public string LastName { get; set; } = ""; 
        public string Role { get; set; } = ""; 
    }
}