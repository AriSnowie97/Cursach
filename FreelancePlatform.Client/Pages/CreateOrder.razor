@page "/create-order"
@using FreelancePlatform.Client
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Створити замовлення — Біржа</PageTitle>

<div class="container mt-5">
    <div class="card shadow p-4 mx-auto" style="max-width: 600px; border-radius: 12px;">
        <h3 class="text-center mb-4 fw-bold text-dark">💼 Нове замовлення</h3>
        <p class="text-muted text-center small">Опишіть ваше завдання, щоб фрілансери могли запропонувати свої послуги</p>
        
        <div class="mb-3">
            <label class="form-label fw-bold">Назва замовлення:</label>
            <input type="text" class="form-control" placeholder="Наприклад: Розробка дизайну для мобільного додатку" @bind="newOrder.Title" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Детальний опис завдання:</label>
            <textarea class="form-control" rows="6" placeholder="Вкажіть вимоги, стек технологій або посилання на ТЗ..." @bind="newOrder.Description"></textarea>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold">Бюджет (грн):</label>
            <div class="input-group">
                <span class="input-group-text">💰</span>
                <input type="number" class="form-control" placeholder="5000" @bind="newOrder.Budget" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorText))
        {
            <div class="alert alert-danger shadow-sm rounded-pill py-2 px-3 small">⚠️ @errorText</div>
        }

        @if (!string.IsNullOrEmpty(successText))
        {
            <div class="alert alert-success shadow-sm rounded-pill py-2 px-3 small">🟢 @successText</div>
        }

        <button class="btn btn-primary w-100 rounded-pill fw-bold py-2 mt-2" @onclick="HandleCreateOrder" disabled="@isLoading">
            @(isLoading ? "Публікація..." : "Опублікувати замовлення")
        </button>
    </div>
</div>

@code {
    private OrderModel newOrder = new OrderModel();
    private string errorText = "";
    private string successText = "";
    private bool isLoading = false;

    private async Task HandleCreateOrder()
    {
        errorText = "";
        successText = "";

        // Валідація полів перед відправкою
        if (string.IsNullOrWhiteSpace(newOrder.Title) || string.IsNullOrWhiteSpace(newOrder.Description))
        {
            errorText = "Будь ласка, заповніть назву та опис замовлення.";
            return;
        }

        if (newOrder.Budget <= 0)
        {
            errorText = "Бюджет повинен бути більшим за 0.";
            return;
        }

        // Прив'язуємо замовлення до реального користувача з LocalStorage
        newOrder.CustomerId = UserState.Id; 

        if (newOrder.CustomerId == 0)
        {
            errorText = "Помилка авторизації: Ваш профіль застарів. Будь ласка, перезайдіть в акаунт!";
            return;
        }

        isLoading = true;

        try
        {
            // Відправляємо POST запит на бекенд
            var response = await Http.PostAsJsonAsync("api/orders", newOrder);

            if (response.IsSuccessStatusCode)
            {
                successText = "Замовлення успішно створено й опубліковано на головній сторінці!";
                newOrder = new OrderModel(); // Очищаємо форму після успіху
            }
            else
            {
                errorText = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrEmpty(errorText))
                {
                    errorText = "Не вдалося зберегти замовлення. Перевірте з'єднання.";
                }
            }
        }
        catch (Exception)
        {
            errorText = "Помилка зв'язку з сервером.";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class OrderModel
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Budget { get; set; }
        public string Status { get; set; } = "Open"; // По замовчуванню відкритий
        public int CustomerId { get; set; }
    }
}